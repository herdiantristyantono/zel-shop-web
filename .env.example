# ════════════════════════════════════════════════════════════════
#  Zel Shop — variabel lingkungan
#  Salin ke .env (lokal) atau isi di dashboard Vercel (produksi).
#  JANGAN commit file .env yang berisi kunci asli.
# ════════════════════════════════════════════════════════════════

# ── Situs ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # produksi: https://zelshop.id
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"           # format internasional tanpa +

# ── Database (PostgreSQL) ───────────────────────────────────────
# Lokal  : jalankan `npm run db:local`, salin URL "postgres://..." yang muncul.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Lokal (prisma dev / PGlite) WAJIB 1. Supabase/Postgres biasa: 5–10.
DATABASE_POOL_MAX=1

# ── Autentikasi (Better Auth) ───────────────────────────────────
# Buat secret acak: `openssl rand -base64 32`
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"               # sama dengan NEXT_PUBLIC_SITE_URL

# Login Google (opsional; tombol Google otomatis muncul jika diisi)
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Akun owner awal yang dibuat oleh `npm run db:seed`
SEED_OWNER_EMAIL="owner@zelshop.test"
SEED_OWNER_PASSWORD="ZelShop#2026"

# ── Email (Resend) ──────────────────────────────────────────────
# Kosongkan saat lokal → email dicetak ke terminal.
# resend.com → API Keys. Verifikasi domain Anda agar email tidak masuk spam.
RESEND_API_KEY=""
EMAIL_FROM="Zel Shop <no-reply@zelshop.id>"

# ── Ongkir: Biteship (aktif sejak Tahap 2) ──────────────────────
# Kosong → tarif & wilayah contoh (mock) agar checkout bisa dicoba lokal.
# dashboard.biteship.com → Integrasi → API Key (pakai key "testing" untuk uji coba)
BITESHIP_API_KEY=""
# ID area gudang/asal kirim. Cari via: curl -H "Authorization: $BITESHIP_API_KEY" \
#   "https://api.biteship.com/v1/maps/areas?countries=ID&type=single&input=40111"
BITESHIP_ORIGIN_AREA_ID=""

# ── Pembayaran: Midtrans (aktif sejak Tahap 3) ─────────────────
# Kosong → mode pengembangan: tombol "Simulasikan pembayaran" di halaman pesanan (tidak tampil di produksi).
# Sandbox: dashboard.sandbox.midtrans.com → Settings → Access Keys. Produksi: dashboard.midtrans.com.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Notifikasi WhatsApp — gateway Fonnte (fonnte.com → Device → Token). Kosong → dicetak ke terminal.
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN=""

# Cron pembatalan otomatis. Vercel Cron mengirim header Authorization: Bearer CRON_SECRET.
# Buat dengan: openssl rand -hex 24
CRON_SECRET=""

# ── Foto produk & banner: Cloudinary (WAJIB di produksi) ────────
# cloudinary.com → Dashboard → API Keys. Kosong di lokal → foto disimpan di public/uploads (WebP).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analitik (dimuat hanya setelah pengunjung menyetujui cookie) ─
NEXT_PUBLIC_GA_ID=""                                  # G-XXXXXXXXXX (Google Analytics 4)
NEXT_PUBLIC_META_PIXEL_ID=""                          # ID Meta Pixel (Events Manager)

# ── Seed ────────────────────────────────────────────────────────
# true (default) = isi data contoh (14 produk, ulasan & pesanan contoh). PRODUKSI: "false"
# → hanya kategori, halaman kebijakan, pengaturan, dan akun owner; katalog tidak dihapus.
SEED_DEMO="true"
