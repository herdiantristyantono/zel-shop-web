# ════════════════════════════════════════════════════════════════
#  Zel Shop — variabel lingkungan
#  Salin ke .env (lokal) atau isi di dashboard Vercel (produksi).
#  JANGAN commit file .env yang berisi kunci asli.
# ════════════════════════════════════════════════════════════════

# ── Situs ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # produksi: https://zelshop.id
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"           # format internasional tanpa +

# ── Database (PostgreSQL) ───────────────────────────────────────
# Lokal  : jalankan `npm run db:local`, salin URL "postgres://..." yang muncul.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Lokal (prisma dev / PGlite) WAJIB 1. Supabase/Postgres biasa: 5–10.
DATABASE_POOL_MAX=1

# ── Autentikasi (Better Auth) ───────────────────────────────────
# Buat secret acak: `openssl rand -base64 32`
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"               # sama dengan NEXT_PUBLIC_SITE_URL

# Login Google (opsional; tombol Google otomatis muncul jika diisi)
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Akun owner awal yang dibuat oleh `npm run db:seed`
SEED_OWNER_EMAIL="owner@zelshop.test"
SEED_OWNER_PASSWORD="ZelShop#2026"

# ── Email (Resend) ──────────────────────────────────────────────
# Kosongkan saat lokal → email dicetak ke terminal.
# resend.com → API Keys. Verifikasi domain Anda agar email tidak masuk spam.
RESEND_API_KEY=""
EMAIL_FROM="Zel Shop <no-reply@zelshop.id>"

# ── Tahap berikutnya (belum dipakai di Tahap 1) ─────────────────
# Penyimpanan gambar
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment gateway — Midtrans (dashboard.midtrans.com → Settings → Access Keys)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# atau Xendit (dashboard.xendit.co → Settings → API Keys / Webhooks)
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""

# Ongkir — Biteship (biteship.com → API Keys) atau RajaOngkir
BITESHIP_API_KEY=""
RAJAONGKIR_API_KEY=""

# Notifikasi WhatsApp (mis. Fonnte / Wablas)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Cron pembatalan otomatis pesanan kedaluwarsa (Vercel Cron mengirim header Authorization: Bearer CRON_SECRET)
CRON_SECRET=""

# Analitik
NEXT_PUBLIC_GA_ID=""                                  # G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""
