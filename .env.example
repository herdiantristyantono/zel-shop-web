# ════════════════════════════════════════════════════════════════
#  Zel Shop — environment variables
#  Copy to .env (local) or set them in the Vercel dashboard (production).
#  DO NOT commit a .env file containing real keys.
# ════════════════════════════════════════════════════════════════

# ── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # production: https://zelshop.id
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"           # international format without +

# ── Database (PostgreSQL) ───────────────────────────────────────
# Local  : run `npm run db:local`, copy the "postgres://..." URL it prints.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Local (prisma dev / PGlite) MUST be 1. Supabase/regular Postgres: 5–10.
DATABASE_POOL_MAX=1

# ── Authentication (Better Auth) ────────────────────────────────
# Generate a random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"               # same as NEXT_PUBLIC_SITE_URL

# Google login (optional; the Google button appears automatically when set)
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Initial owner account created by `npm run db:seed`
SEED_OWNER_EMAIL="owner@zelshop.test"
SEED_OWNER_PASSWORD="ZelShop#2026"

# ── Email (Resend) ──────────────────────────────────────────────
# Leave empty locally → emails are printed to the terminal.
# resend.com → API Keys. Verify your domain so emails don't land in spam.
RESEND_API_KEY=""
EMAIL_FROM="Zel Shop <no-reply@zelshop.id>"

# ── Checkout mode ───────────────────────────────────────────────
# "whatsapp" → no online payment & no courier choice at checkout. The buyer confirms the order
# to the admin via WhatsApp; the admin agrees shipping cost & payment, then confirms payment
# (shipping cost, courier, method) in Admin → Orders. Empty = normal flow (Midtrans + Biteship rates).
# The buyer types the full address in one field (no district search), so Biteship is not needed.
CHECKOUT_MODE=""

# ── Shipping: Biteship (active since Phase 2) ───────────────────
# Empty → sample (mock) rates & areas so checkout can be tried locally.
# dashboard.biteship.com → Integration → API Key (use the "testing" key for trials)
BITESHIP_API_KEY=""
# Area ID of the warehouse/origin. Look it up via: curl -H "Authorization: $BITESHIP_API_KEY" \
#   "https://api.biteship.com/v1/maps/areas?countries=ID&type=single&input=40111"
BITESHIP_ORIGIN_AREA_ID=""

# ── Payment: Midtrans (active since Phase 3) ────────────────────
# Empty → development mode: "Simulate payment" button on the order page (hidden in production).
# Sandbox: dashboard.sandbox.midtrans.com → Settings → Access Keys. Production: dashboard.midtrans.com.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# WhatsApp notifications — Fonnte gateway (fonnte.com → Device → Token). Empty → printed to the terminal.
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN=""

# Automatic cancellation cron. Vercel Cron sends the header Authorization: Bearer CRON_SECRET.
# Generate with: openssl rand -hex 24
CRON_SECRET=""

# ── Product & banner photos: Cloudinary (REQUIRED in production) ─
# cloudinary.com → Dashboard → API Keys. Empty locally → photos are stored in public/uploads (WebP).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics (loaded only after the visitor accepts cookies) ───
NEXT_PUBLIC_GA_ID=""                                  # G-XXXXXXXXXX (Google Analytics 4)
NEXT_PUBLIC_META_PIXEL_ID=""                          # Meta Pixel ID (Events Manager)

# ── Seed ────────────────────────────────────────────────────────
# true (default) = seed sample data (14 products, sample reviews & orders). PRODUCTION: "false"
# → only categories, policy pages, settings, and the owner account; the catalog is not deleted.
SEED_DEMO="true"
